# Gallery admin (local dev — /admin)
GALLERY_ADMIN_PASSWORD=your-secret-password

# Optional: separate signing secret (defaults to GALLERY_ADMIN_PASSWORD)
# GALLERY_ADMIN_SECRET=

# Vercel AI Gateway — analyze uploads (tags, location, timestamp)
# Create a key at https://vercel.com/~/ai/api-keys or run: vercel env pull
# Without this key, bulk upload still reads EXIF timestamps when present.
AI_GATEWAY_API_KEY=

# Optional vision model (default: openai/gpt-5.4)
# GALLERY_AI_MODEL=openai/gpt-5.4

# Vercel Blob — gallery images + metadata (enables /gallery and /admin on Vercel)
# Create a store: vercel blob create  — or link via Dashboard → Storage → Blob
BLOB_READ_WRITE_TOKEN=
